# Conexión a la base de datos (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db
# Alternativa para desarrollo sin PostgreSQL:
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT (mínimo 32 caracteres)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
# Expiración del token y de la cookie, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS
FRONTEND_ORIGIN=http://localhost:5173

# true solo si el backend se sirve por HTTPS
COOKIE_SECURE=false
